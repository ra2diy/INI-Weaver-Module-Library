        //每个：ID=String / O#ID,Key1=Value1
        //{0} : ID
        //{1} : String (EnumCombo) : 
        //Equal NEqual Empty NEmpty RegexFull RegexMatch RegexNotFull RegexNotMatch 
        //{2} : Value1 (InputText)
        "ConstraintsInput" : {
            "Multiple": true,
            "Form": {
                "Input": [
                    {
                        "Type": "InputText",
                        "ValueID": 0,
                        "Hint": "受约束的ID"
                    },
                    {
                        "Type": "EnumCombo",
                        "ValueID": 1,
                        "InitialValue": "Equal",
                        "Hint": "约束类型",
                        "Options": {
                            "Equal": "等于",
                            "NEqual": "不等于",
                            "Empty": "为空",
                            "NEmpty": "不为空",
                            "RegexFull": ["正则完全匹配", "需满足整个字符串完全匹配正则表达式。"],
                            "RegexMatch": ["正则部分匹配", "需满足字符串中包含正则表达式的某个匹配。"],
                            "RegexNotFull": ["正则不完全匹配", "需满足字符串中不能完全匹配正则表达式。"],
                            "RegexNotMatch": ["正则完全不匹配", "需满足字符串中不包含正则表达式的任一匹配。"]
                        }
                    },
                    {
                        "Constraint": {
                            "1": {"RegexNotMatch": "^(Empty|NEmpty)$"}
                        },
                        "Type": "InputText",
                        "ValueID": 2,
                        "Hint": "约束值"
                    },
                    "<Separator>"
                ],
                "Format": [
                    {
                        "ValueList": [0, 1, 2]
                    }
                ]
            },
            "ExportMode": {
                "Type": "Recompose",
                "ExportLines": [
                    {
                        //枚举{1}的8个值，分别输出：
                        //Equal ： {0}={2}
                        //NEqual ： {0}=!{2}
                        //Empty ： {0}=<EMPTY>
                        //NEmpty ： {0}=!<EMPTY>
                        //RegexFull ： O#{0},RegexFull={2}
                        //RegexMatch ： O#{0},RegexMatch={2}
                        //RegexNotFull ： O#{0},RegexNotFull={2}
                        //RegexNotMatch ： O#{0},RegexNotMatch={2}
                        "Key": [
                            {
                                "ExportConstraint": { "1": {"RegexMatch" : "^Regex" } },
                                "Text": "O#"
                            },
                            {
                                "ValueIDToString": 0
                            },
                            {
                                "ExportConstraint": { "1": {"RegexMatch" : "^Regex" } },
                                "Text": ","
                            },
                            {
                                "ExportConstraint": { "1": {"RegexMatch" : "^Regex" } },
                                "ValueIDToString": 1
                            }
                        ],
                        "Value": [
                            {
                                "ExportConstraint": { "1": "NEqual" },
                                "Text": "!"
                            },
                            {
                                "ExportConstraint": { "1": "Empty" },
                                "Text": "<EMPTY>"
                            },
                            {
                                "ExportConstraint": { "1": "NEmpty" },
                                "Text": "!<EMPTY>"
                            },
                            {
                                "ExportConstraint": { "1": {"RegexNotMatch": "^(Empty|NEmpty)$"} },
                                "ValueIDToString": 2
                            }
                        ]
                    }
                ]
            }
        },
        /*
        Int：用a,b,c的格式存储3个整数。
        Float：用a,b,c的格式存储3个浮点数。
        Hex：用xxyyzz的十六进制数存储。
