                        "Options": {
                            "Int": "int(如255,255,255)",
                            "Float": "float(如0.5,0.5,0.5)",
                            "Hex": "hex(如FF0000)",
                            "#Hex": "#hex(如#FF0000)"
                        }
                    }
                ],
                "Format": [
                    { "ValueIDToString": 0 }
                ]
            }
        },
